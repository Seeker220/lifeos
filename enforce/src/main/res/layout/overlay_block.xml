<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/overlay_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/overlay_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/overlay_title_focus_block"
            android:textColor="#E8EEF5"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#97A3B2"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/overlay_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#A8C7FA"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/overlay_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/overlay_btn_work"
            android:backgroundTint="#A8C7FA"
            android:elevation="0dp"
            android:minHeight="48dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:stateListAnimator="@null"
            android:text="@string/overlay_back"
            android:textAllCaps="false"
            android:textColor="#0A305F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/overlay_override"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/overlay_btn_override"
            android:backgroundTint="#00000000"
            android:elevation="0dp"
            android:minHeight="44dp"
            android:stateListAnimator="@null"
            android:text="@string/overlay_override"
            android:textAllCaps="false"
            android:textColor="#97A3B2"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
